<launch>
  <!-- specify the planning pipeline -->
  <arg name="pipeline" default="ompl" />

  <!-- By default, we do not start a database (it can be large) -->
  <arg name="db" default="false" />
  <!-- Allow user to specify database location -->
  <arg name="db_path" default="$(find rm_scr_moveit_config)/default_warehouse_mongo_db" />

  <!-- By default, we are not in debug mode -->
  <arg name="debug" default="false" />

  <!-- By default, we will load or override the robot_description -->
  <arg name="load_robot_description" default="true"/>

  <!-- Set execution mode for fake execution controllers -->
  <arg name="fake_execution_type" default="interpolate" />

  <!-- 关闭所有GUI！核心修改1 -->
  <arg name="use_gui" default="false" />
  <!-- 关闭RViz！核心修改2 -->
  <arg name="use_rviz" default="false" />

  <!-- 加载机器人URDF模型 -->
  <param name="robot_description" command="$(find xacro)/xacro $(find rm_scr_description)/urdf/rm_scr_description.urdf.xacro" />
  
  <!-- 核心节点：纯后台解析URDF，自动发布完整TF树（无界面） -->
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="false" output="screen"/>

  <!-- Run the main MoveIt! executable without trajectory execution -->
  <include file="$(find rm_scr_moveit_config)/launch/move_group.launch">
    <arg name="allow_trajectory_execution" value="true"/>
    <arg name="fake_execution" value="false"/>
    <arg name="fake_execution_type" value="$(arg fake_execution_type)"/>
    <arg name="info" value="true"/>
    <arg name="debug" value="$(arg debug)"/>
    <arg name="pipeline" value="$(arg pipeline)"/>
    <arg name="load_robot_description" value="$(arg load_robot_description)"/>
  </include>

  <!-- 因为use_rviz=false，这部分自动不运行 -->
  <!-- <include file="$(find rm_scr_moveit_config)/launch/moveit_rviz.launch" if="$(arg use_rviz)">
    <arg name="rviz_config" value="$(find rm_scr_moveit_config)/launch/moveit.rviz"/>
  </include> -->

  <!-- Database launch -->
  <include file="$(find rm_scr_moveit_config)/launch/default_warehouse_db.launch" if="$(arg db)">
    <arg name="moveit_warehouse_database_path" value="$(arg db_path)"/>
  </include>

</launch>