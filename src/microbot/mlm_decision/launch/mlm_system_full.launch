<?xml version="1.0"?>
<launch>
    <!-- 
    完整系统一键启动文件（含移动控制）
    启动所有组件：麦克风、相机、Whisper ASR、Minimax TTS、MLM 决策中枢、
    视觉抓取技能、语音移动控制技能、机械臂抓取执行
    
    系统架构：
    1. 麦克风 → 语音识别 (Whisper ASR)
    2. 语音识别文本 + Realsense RGB 图像 → MLM 决策中枢 (Qwen3-VL-8B)
    3. MLM 根据技能选择执行：
       - 语音交互：图像描述、知识问答、闲聊 → TTS → 播放
       - 视觉抓取：提取物体 → GroundingDINO → 机械臂抓取
       - 移动控制：解析移动意图 → 底盘 TCP 控制（前进/后退/左转/右转/目标点导航）
    
    视觉抓取方案选择：
    - 方案 1（graspnet）：原方案，使用 vision_processor + graspnet_generator 完整流程
    - 方案 2（simplified）：简化方案，使用 visual_grasping_skill 直接生成抓取位姿
    -->

    <!-- 语音识别模型选择：whisper 或 funasr -->
    <arg name="asr_engine" default="whisper"/>

    <!-- 1、参数配置 -->
    <arg name="mlm_model" default="qwen3.5:0.8b"/>  <!-- or Qwen3-VL-8B 模型 -->
    <arg name="asr_model" default="base"/>
    <arg name="use_camera" default="true"/>
    <arg name="use_mic" default="true"/>
    <arg name="use_grasping" default="true"/>
    <arg name="use_move_control" default="true"/>

    <!-- 视觉抓取方案选择：graspnet 或 simplified -->
    <arg name="grasp_scheme" default="simplified"/>

    <!-- 2、启动麦克风节点（如果使用） -->
    <include if="$(arg use_mic)" file="$(find voice_assistant)/launch/mic.launch">
        <arg name="usart_port_name" value="/dev/wheeltec_mic"/>
    </include>

    <!-- 3、启动Realsense相机（如果使用） -->
    <include if="$(arg use_camera)" file="$(find realsense2_camera)/launch/rs_camera.launch">
        <arg name="align_depth" value="true"/>
    </include>

    <!-- 4、Whisper 语音识别节点（需要独立终端接收键盘输入） -->
    <node if="$(eval arg('asr_engine') == 'whisper')"
          name="whisper_asr" pkg="voice_assistant" type="whisper_asr.py" 
          output="screen" launch-prefix="gnome-terminal -e">
        <param name="asr_model" value="$(arg asr_model)"/>
        <param name="wav_path" value="/home/rm/realman_ws/src/microbot/voice_assistant/scripts/audio_temp/test_record.wav"/>
    </node>

    <!-- 4b、FunASR 语音识别节点（需要独立终端接收键盘输入） -->
    <node if="$(eval arg('asr_engine') == 'funasr')"
          name="funasr_asr" pkg="voice_assistant" type="funasr_asr.py" 
          output="screen" launch-prefix="gnome-terminal -e">
        <param name="asr_model" value="paraformer-zh"/>
        <param name="wav_path" value="/home/rm/realman_ws/src/microbot/voice_assistant/scripts/audio_temp/test_record.wav"/>
    </node>

    <!-- 5、Minimax 语音合成节点 -->
    <node name="minimax_tts" pkg="voice_assistant" type="minimax_tts.py" output="screen">
        <param name="temp_dir" value="/home/rm/realman_ws/src/microbot/voice_assistant/scripts/audio_temp"/>
    </node>

    <!-- 6、MLM 决策中枢节点（需要独立终端接收键盘输入） -->
    <node name="mlm_decision_node" pkg="mlm_decision" type="mlm_decision_node.py" 
          output="screen" launch-prefix="gnome-terminal -e">
        <param name="ollama_url" value="http://localhost:11434/v1"/>
        <param name="mlm_model" value="$(arg mlm_model)"/>
    </node>

    <!-- 7、方案 1：GraspNet 完整流程（vision_processor + graspnet_generator） -->
    <include if="$(eval arg('use_grasping') and arg('grasp_scheme') == 'graspnet')" 
             file="$(find graspnet_ros)/launch/vision_graspnet_generator.launch">
        <remap from="/grasp_target_name" to="/vision_processor/text_prompt"/>
        <param name="trigger_vision" value="False"/>
    </include>

    <!-- 8、方案 2：简化视觉抓取技能（GroundingDINO + 直接生成抓取位姿） -->
    <node if="$(eval arg('use_grasping') and arg('grasp_scheme') == 'simplified')" 
          name="visual_grasping_skill" pkg="mlm_decision" type="visual_grasping_skill.py" 
          output="screen">
        <param name="grounding_dino_model" value="GroundingDINO_SwinT_OGC"/>
        <param name="model_dir" value="/home/rm/realman_ws/src/graspnet_ros/models"/>
        <param name="box_threshold" value="0.35"/>
        <param name="text_threshold" value="0.25"/>
    </node>

    <!-- 9、语音移动控制技能节点 -->
    <node if="$(arg use_move_control)" 
          name="voice_move_control" pkg="mlm_decision" type="voice_move_control.py" 
          output="screen">
        <param name="chassis_ip" value="192.168.10.10"/>
        <param name="chassis_port" value="31001"/>
        <param name="max_linear" value="0.3"/>
        <param name="max_angular" value="0.8"/>
        <param name="send_interval" value="0.1"/>
        <param name="distance_tolerance" value="0.1"/>
        <param name="theta_tolerance" value="0.1"/>
    </node>

    <!-- 10、抓取执行节点（两种方案都使用） -->
    <node if="$(arg use_grasping)" 
          name="grasp_executor" pkg="rm_scr_demo" type="grasp_executor.py" 
          output="screen">
    </node>

</launch>
