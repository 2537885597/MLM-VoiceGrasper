ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda-11.4/bin/nvcc

cflags = -pthread -B /home/rm/miniconda3/envs/microbot/compiler_compat -Wl,--sysroot=/ -Wsign-compare -DNDEBUG -g -fwrapv -O3 -Wall -Wstrict-prototypes -fPIC -DWITH_CUDA -I/home/rm/realman_ws/src/graspnet-baseline/knn/src -I/home/rm/miniconda3/envs/microbot/lib/python3.8/site-packages/torch/include -I/home/rm/miniconda3/envs/microbot/lib/python3.8/site-packages/torch/include/torch/csrc/api/include -I/home/rm/miniconda3/envs/microbot/lib/python3.8/site-packages/torch/include/TH -I/home/rm/miniconda3/envs/microbot/lib/python3.8/site-packages/torch/include/THC -I/usr/local/cuda-11.4/include -I/home/rm/miniconda3/envs/microbot/include/python3.8 -c
post_cflags = -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1013"' -DTORCH_EXTENSION_NAME=knn_pytorch -D_GLIBCXX_USE_CXX11_ABI=1 -std=c++17
cuda_cflags = -DWITH_CUDA -I/home/rm/realman_ws/src/graspnet-baseline/knn/src -I/home/rm/miniconda3/envs/microbot/lib/python3.8/site-packages/torch/include -I/home/rm/miniconda3/envs/microbot/lib/python3.8/site-packages/torch/include/torch/csrc/api/include -I/home/rm/miniconda3/envs/microbot/lib/python3.8/site-packages/torch/include/TH -I/home/rm/miniconda3/envs/microbot/lib/python3.8/site-packages/torch/include/THC -I/usr/local/cuda-11.4/include -I/home/rm/miniconda3/envs/microbot/include/python3.8 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -DCUDA_HAS_FP16=1 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1013"' -DTORCH_EXTENSION_NAME=knn_pytorch -D_GLIBCXX_USE_CXX11_ABI=1 -gencode=arch=compute_87,code=compute_87 -gencode=arch=compute_87,code=sm_87 -std=c++17
cuda_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc  $cuda_cflags -c $in -o $out $cuda_post_cflags





